# Public since 2026-10-07: no X-Robots-Tag (it said "noindex, nofollow, noarchive" while the site was a private preview).
# One canonical host and one URL for the page, loomwest.com's law of 2026-09-07 (Search Console flags www and
# index.html twins): www.andre -> andre, /index.html -> /. http -> https is already a 301 from the host.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.andre\.loomwest\.com$ [NC]
RewriteRule ^(.*)$ https://andre.loomwest.com/$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
ErrorDocument 404 /404.html
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType text/vtt .vtt
  AddType image/webp .webp
  AddType application/xml .xml
</IfModule>
